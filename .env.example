# =============================================================================
# VARENO ENVIRONMENT CONFIGURATION
# =============================================================================

# Contact Notification Service (Resend)
# Optional in preview; required for live email delivery to your inbox.
# Get your API key from https://resend.com
RESEND_API_KEY="re_1234567890abcdef"

# Inbox where prospective client & agency enquiries should be sent
CONTACT_TO_EMAIL="your-receiving-inbox@yourdomain.com"

# Verified sending address in Resend (e.g., onboarding@resend.dev or hello@yourdomain.com)
CONTACT_FROM_EMAIL="enquiries@yourdomain.com"

# Production site URL (Update once Vercel assigns your *.vercel.app domain)
# Used for canonical SEO links, Open Graph absolute URLs, and sitemap generation
SITE_URL="https://your-app-name.vercel.app"
VITE_SITE_URL="https://your-app-name.vercel.app"

# Server Port (Default is 3000)
PORT=3000
